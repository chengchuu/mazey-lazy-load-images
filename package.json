{
  "name": "mazey-lazy-load-images",
  "version": "2.0.2",
  "description": "Render responsive, lazy-loaded image collections with React 19.",
  "main": "./lib/index.cjs.js",
  "module": "./lib/index.esm.mjs",
  "types": "./lib/index.d.ts",
  "typings": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.esm.mjs",
      "require": "./lib/index.cjs.js",
      "default": "./lib/index.esm.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "mainEntryPointFilePath": "lib/index.d.ts",
  "scripts": {
    "dev": "webpack serve --config scripts/webpack.config.js",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && rollup --forceExit -c scripts/rollup.config.mjs",
    "test": "jest",
    "build:site": "webpack --mode production --env pages --config scripts/webpack.config.js",
    "docs:api": "typedoc --out docs/api --readme README.md --excludePrivate --excludeProtected --excludeInternal --hideGenerator src/index.ts",
    "docs": "npm run docs:api && npm run build:site && node scripts/build-pages.cjs && npm run seo:validate && npm run pwa:validate",
    "seo:validate": "node scripts/validate-site.cjs seo",
    "pwa:validate": "node scripts/validate-site.cjs pwa",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,examples,site}/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"{src,examples,site}/**/*.{ts,tsx}\" --fix",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "preview": "npm run typecheck && npm run lint && npm run build && npm run test -- --runInBand && npm run docs",
    "release": "npm run preview && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengchuu/mazey-lazy-load-images.git"
  },
  "keywords": [
    "React",
    "TypeScript",
    "lazy-loading",
    "masonry",
    "waterfall-layout",
    "images"
  ],
  "author": "Cheng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chengchuu/mazey-lazy-load-images/issues"
  },
  "homepage": "https://chengchuu.github.io/mazey-lazy-load-images/",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-jest": "^30.4.1",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "^1.13.1",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.2",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^16.4.0",
    "mazey": "^5.7.4",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "ts-loader": "^9.6.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  }
}
