{
  "name": "mazey-lazy-load-images",
  "version": "1.2.1",
  "description": "Lazy load images.",
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "typings": "lib/index.d.ts",
  "mainEntryPointFilePath": "lib/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "webpack-dev-server --open",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && rollup -c rollup.config.mjs",
    "test": "jest",
    "docs": "typedoc --out docs/ src/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "prepare": "husky",
    "preview": "npm run build && npm run test",
    "release": "npm run preview && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chengchuu/mazey-lazy-load-images.git"
  },
  "keywords": [
    "JavaScript",
    "Function"
  ],
  "author": "Cheng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/chengchuu/mazey-lazy-load-images/issues"
  },
  "homepage": "https://github.com/chengchuu/mazey-lazy-load-images",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "core-js": "^3.50.0",
    "eslint": "^9.39.2",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "ts-loader": "^9.6.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6"
  },
  "dependencies": {
    "mazey": "^1.4.39"
  }
}
